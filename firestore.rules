rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      let email = (request.auth.token.email != null) ? request.auth.token.email.lower() : '';
      return isSignedIn() && (
        email == 'marzanleonardojrc@gmail.com' || 
        email == 'marzan.leonardo04@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().status == 'Approved')
      );
    }
    
    function hasRole(role) {
      return isApproved() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role == role;
    }

    function isAdmin() { 
      let email = (request.auth.token.email != null) ? request.auth.token.email.lower() : '';
      return isSignedIn() && (
        email == 'marzanleonardojrc@gmail.com' || 
        email == 'marzan.leonardo04@gmail.com' || 
        hasRole('Admin')
      ); 
    }
    
    function isEncoder() { return isAdmin() || hasRole('End-User'); }
    function isViewer() { return isAdmin() || isApproved(); }
    
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email == (request.auth.token.email != null ? request.auth.token.email : '') &&
             data.role in ['Admin', 'End-User'] &&
             data.status in ['Pending', 'Approved', 'Denied'] &&
             (resource == null ? data.createdAt == request.time : data.createdAt == existing().createdAt);
    }

    function isValidProperty(data) {
      let isCreate = resource == null;
      let requiredFields = ['ownerName', 'ownerAddress', 'effectivityDate', 'tdNumber', 'detailedLocation', 'barangay', 'municipality', 'province', 'classification', 'area', 'assessedValue', 'updatedAt', 'createdAt'];
      
      let barangays = ['Bayabas', 'Borlongan', 'Buenavista', 'Calaocan', 'Diamanen', 'Dianed', 'Diarabasin', 'Dibutunan', 'Dimabuno', 'Dinadiawan', 'Ditale', 'Gupa', 'Ipil', 'Laboy', 'Lipit', 'Lobbot', 'Maligaya', 'Mijares', 'Mucdol', 'North Poblacion', 'Puangi', 'Salay', 'Sapangkawayan', 'South Poblacion', 'Toytoyan'];

      // On create, all required fields must be present
      // On update, we only check if present fields have the right type
      let base = (isCreate ? data.keys().hasAll(requiredFields) : true) &&
                 (!('ownerName' in data.keys()) || data.ownerName is string) &&
                 (!('ownerAddress' in data.keys()) || data.ownerAddress is string) &&
                 (!('effectivityDate' in data.keys()) || data.effectivityDate is string) &&
                 (!('tdNumber' in data.keys()) || data.tdNumber is string) &&
                 (!('detailedLocation' in data.keys()) || data.detailedLocation is string) &&
                 (!('barangay' in data.keys()) || data.barangay in barangays || (resource != null && data.barangay == existing().barangay)) &&
                 (!('municipality' in data.keys()) || data.municipality == 'Dipaculao') &&
                 (!('province' in data.keys()) || data.province == 'Aurora') &&
                 (!('classification' in data.keys()) || data.classification in ['LAND', 'BUILDING', 'MACHINERY']) &&
                 (!('area' in data.keys()) || data.area is string) &&
                 (!('assessedValue' in data.keys()) || data.assessedValue is number) &&
                 data.updatedAt == request.time &&
                 (isCreate ? data.createdAt == request.time : true);
      
      let extra = (!('id' in data.keys()) || data.id is string) &&
                  (!('pin' in data.keys()) || data.pin is string) &&
                  (!('administratorName' in data.keys()) || data.administratorName is string) &&
                  (!('administratorAddress' in data.keys()) || data.administratorAddress is string) &&
                  (!('street' in data.keys()) || data.street is string) &&
                  (!('lotNo' in data.keys()) || data.lotNo is string) &&
                  (!('blkNo' in data.keys()) || data.blkNo is string) &&
                  (!('octTct' in data.keys()) || data.octTct is string) &&
                  (!('cctCloa' in data.keys()) || data.cctCloa is string) &&
                  (!('previousTdNo' in data.keys()) || data.previousTdNo is string) &&
                  (!('previousOwner' in data.keys()) || data.previousOwner is string) &&
                  (!('previousAssessedValue' in data.keys()) || data.previousAssessedValue is number) &&
                  (!('recordedBy' in data.keys()) || data.recordedBy is string) &&
                  (!('imported' in data.keys()) || data.imported is bool) &&
                  (!('isArchived' in data.keys()) || data.isArchived is bool) &&
                  (!('archivedAt' in data.keys()) || data.archivedAt == null || data.archivedAt is string);
                 
      return base && extra;
    }

    function isValidDelinquency(data) {
      let base = data.propertyId is string &&
                 data.year is number &&
                 data.basicTaxDue is number &&
                 data.sefTaxDue is number &&
                 (!('idleSurcharge' in data.keys()) || data.idleSurcharge is number) &&
                 data.penalty is number &&
                 data.interest is number &&
                 data.totalDue is number &&
                 (!('totalPaid' in data.keys()) || data.totalPaid is number) &&
                 data.status in ['Delinquent', 'Paid', 'Voided', 'Pending'] &&
                 (!('recordedBy' in data.keys()) || data.recordedBy is string) &&
                 (!('createdBy' in data.keys()) || data.createdBy is string) &&
                 data.updatedAt == request.time &&
                 (resource == null ? data.createdAt == request.time : true) &&
                 // Ensure property exists on creation
                 (resource == null ? exists(/databases/$(database)/documents/properties/$(data.propertyId)) : true);
      
      let paymentCheck = (!('paymentDetails' in data.keys())) || data.paymentDetails == null ||
                         (data.paymentDetails is map && data.paymentDetails.orNumber is string);

      let pendingCheck = (!('pendingUpdate' in data.keys())) || data.pendingUpdate == null || (data.pendingUpdate is map);
      let voidCheck = (!('voidMetadata' in data.keys())) || data.voidMetadata == null || (data.voidMetadata is map);
          
      return base && paymentCheck && pendingCheck && voidCheck;
    }

    function isValidPayment(data) {
      return data.delinquencyId is string &&
             data.propertyId is string &&
             data.orNumber is string &&
             data.amountPaid is number &&
             data.status in ['Active', 'Voided'] &&
             data.recordedAt is string &&
             // Ensure delinquency exists
             exists(/databases/$(database)/documents/delinquencies/$(data.delinquencyId));
    }

    function isValidAuditLog(data) {
      return data.userId == request.auth.uid &&
             data.timestamp == request.time &&
             data.action is string &&
             data.entityType is string;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isAdmin() || (userId == request.auth.uid && incoming().role == existing().role); // Can't self-promote
      allow delete: if isAdmin();
    }

    match /properties/{propertyId} {
      allow read: if isViewer();
      allow create: if isEncoder() && isValidProperty(incoming()) && isValidId(propertyId);
      allow update: if isEncoder() && isValidProperty(incoming());
      allow delete: if isAdmin();
    }

    match /delinquencies/{delinqId} {
      allow read: if isViewer();
      allow create: if isEncoder() && isValidDelinquency(incoming()) && isValidId(delinqId);
      allow update: if isEncoder() && isValidDelinquency(incoming()) &&
                    (
                      // Allow updating most fields directly as an encoder
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'year', 'basicTaxDue', 'sefTaxDue', 'idleSurcharge', 'penalty', 'interest', 'totalDue', 'totalPaid', 'paymentDetails', 'voidMetadata', 'pendingUpdate'])
                    );
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isViewer();
      allow create: if isEncoder() && isValidPayment(incoming());
      allow update: if isEncoder() && isValidPayment(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'voidMetadata', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidAuditLog(incoming());
      // No updates or deletes allowed
    }

    match /reconciliations/{yearId} {
      allow read: if isViewer();
      allow create, update: if isEncoder();
      allow delete: if isAdmin();
    }

    match /user_mappings/{mappingId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource != null && existing().email == (request.auth.token.email != null ? request.auth.token.email : ''));
    }
  }
}
