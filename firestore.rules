rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net - TEMP OPEN FOR CLEANUP SCRIPT
    match /{document=**} {
      allow read, write: if true;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'marzanleonardojrc@gmail.com') || 
        (request.auth.token.email != null && request.auth.token.email.lower() == 'marzan.leonardo04@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().status == 'Approved' || getUserData().role == 'Taxpayer' || getUserData().role == 'Resident'))
      );
    }
    
    function hasRole(role) {
      return isApproved() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role == role;
    }

    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'marzanleonardojrc@gmail.com') || 
        (request.auth.token.email != null && request.auth.token.email.lower() == 'marzan.leonardo04@gmail.com') || 
        hasRole('Admin')
      ); 
    }
    
    function isEncoder() { return isAdmin() || hasRole('User') || hasRole('End-User'); }
    function isViewer() { return isAdmin() || isApproved(); }
    
    function isTaxpayer() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (getUserData().role == 'Taxpayer' || getUserData().role == 'Resident');
    }

    function isNum(val) { return val is int || val is float; }
    function isTime(val) { return val is timestamp || (val is string && val.size() <= 200); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.@-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.role in ['Admin', 'User', 'Guest', 'End-User', 'Taxpayer', 'Resident'] &&
             data.status in ['Pending', 'Approved', 'Denied'] &&
             (!('linkedPropertyIds' in data.keys()) || data.linkedPropertyIds is list);
    }

    function isValidProperty(data) {
      let isCreate = resource == null;
      let requiredFields = ['ownerName', 'tdNumber', 'barangay', 'classification', 'assessedValue'];
      
      let base = (isCreate ? data.keys().hasAll(requiredFields) : true) &&
                 (!('ownerName' in data.keys()) || (data.ownerName is string && data.ownerName.size() <= 500)) &&
                 (!('ownerAddress' in data.keys()) || (data.ownerAddress is string && data.ownerAddress.size() <= 500)) &&
                 (!('effectivityDate' in data.keys()) || (data.effectivityDate is string && data.effectivityDate.size() <= 100)) &&
                 (!('tdNumber' in data.keys()) || (data.tdNumber is string && data.tdNumber.size() <= 100)) &&
                 (!('detailedLocation' in data.keys()) || (data.detailedLocation is string && data.detailedLocation.size() <= 500)) &&
                 (!('barangay' in data.keys()) || (data.barangay is string && data.barangay.size() <= 200)) &&
                 (!('municipality' in data.keys()) || (data.municipality is string && data.municipality.size() <= 200)) &&
                 (!('province' in data.keys()) || (data.province is string && data.province.size() <= 200)) &&
                 (!('classification' in data.keys()) || (data.classification is string && data.classification.size() <= 100)) &&
                 (!('area' in data.keys()) || (data.area is string && data.area.size() <= 100)) &&
                 (!('assessedValue' in data.keys()) || isNum(data.assessedValue)) &&
                 (!('updatedAt' in data.keys()) || isTime(data.updatedAt)) &&
                 (!('createdAt' in data.keys()) || isTime(data.createdAt));
      
      let extra = (!('id' in data.keys()) || (data.id is string && data.id.size() <= 200)) &&
                  (!('pin' in data.keys()) || (data.pin is string && data.pin.size() <= 200)) &&
                  (!('administratorName' in data.keys()) || (data.administratorName is string && data.administratorName.size() <= 500)) &&
                  (!('administratorAddress' in data.keys()) || (data.administratorAddress is string && data.administratorAddress.size() <= 500)) &&
                  (!('street' in data.keys()) || (data.street is string && data.street.size() <= 200)) &&
                  (!('lotNo' in data.keys()) || (data.lotNo is string && data.lotNo.size() <= 200)) &&
                  (!('blkNo' in data.keys()) || (data.blkNo is string && data.blkNo.size() <= 200)) &&
                  (!('octTct' in data.keys()) || (data.octTct is string && data.octTct.size() <= 200)) &&
                  (!('cctCloa' in data.keys()) || (data.cctCloa is string && data.cctCloa.size() <= 200)) &&
                  (!('previousTdNo' in data.keys()) || (data.previousTdNo is string && data.previousTdNo.size() <= 200)) &&
                  (!('previousOwner' in data.keys()) || (data.previousOwner is string && data.previousOwner.size() <= 500)) &&
                  (!('previousAssessedValue' in data.keys()) || isNum(data.previousAssessedValue)) &&
                  (!('recordedBy' in data.keys()) || (data.recordedBy is string && data.recordedBy.size() <= 200)) &&
                  (!('imported' in data.keys()) || data.imported is bool) &&
                  (!('isArchived' in data.keys()) || data.isArchived is bool) &&
                  (!('archivedAt' in data.keys()) || data.archivedAt == null || (data.archivedAt is string && data.archivedAt.size() <= 200));
                 
      return base && extra;
    }

    function isValidDelinquency(data) {
      let isCreate = resource == null;
      let requiredFields = ['propertyId', 'year', 'basicTaxDue', 'status'];

      let base = (isCreate ? data.keys().hasAll(requiredFields) : true) &&
                 (!('propertyId' in data.keys()) || data.propertyId is string) &&
                 (!('year' in data.keys()) || data.year is int) &&
                 (!('basicTaxDue' in data.keys()) || isNum(data.basicTaxDue)) &&
                 (!('sefTaxDue' in data.keys()) || isNum(data.sefTaxDue)) &&
                 (!('idleSurcharge' in data.keys()) || isNum(data.idleSurcharge)) &&
                 (!('penalty' in data.keys()) || isNum(data.penalty)) &&
                 (!('interest' in data.keys()) || isNum(data.interest)) &&
                 (!('totalDue' in data.keys()) || isNum(data.totalDue)) &&
                 (!('totalPaid' in data.keys()) || isNum(data.totalPaid)) &&
                 (!('status' in data.keys()) || data.status in ['Delinquent', 'Paid', 'Voided', 'Pending', 'NOTICE_ISSUED']) &&
                 (!('recordedBy' in data.keys()) || data.recordedBy is string) &&
                 (!('createdBy' in data.keys()) || data.createdBy is string) &&
                 (!('updatedAt' in data.keys()) || isTime(data.updatedAt)) &&
                 (!('createdAt' in data.keys()) || isTime(data.createdAt)) &&
                 (!('noticeIssuedAt' in data.keys()) || isTime(data.noticeIssuedAt)) &&
                 // Ensure property exists on creation
                 (resource == null ? exists(/databases/$(database)/documents/properties/$(data.propertyId)) : true);
      
      let paymentCheck = (!('paymentDetails' in data.keys())) || data.paymentDetails == null ||
                          (data.paymentDetails is map && (!('orNumber' in data.paymentDetails.keys()) || data.paymentDetails.orNumber is string));

      let pendingCheck = (!('pendingUpdate' in data.keys())) || data.pendingUpdate == null || (data.pendingUpdate is map);
      let voidCheck = (!('voidMetadata' in data.keys())) || data.voidMetadata == null || (data.voidMetadata is map);
          
      return base && paymentCheck && pendingCheck && voidCheck;
    }

    function isValidPayment(data) {
      let isCreate = resource == null;
      let requiredFields = ['delinquencyId', 'propertyId', 'orNumber', 'amountPaid', 'status', 'recordedAt'];
      return (isCreate ? data.keys().hasAll(requiredFields) : true) &&
             (!('delinquencyId' in data.keys()) || data.delinquencyId is string) &&
             (!('propertyId' in data.keys()) || data.propertyId is string) &&
             (!('orNumber' in data.keys()) || data.orNumber is string) &&
             (!('amountPaid' in data.keys()) || isNum(data.amountPaid)) &&
             (!('status' in data.keys()) || data.status in ['Active', 'Voided']) &&
             (!('recordedAt' in data.keys()) || isTime(data.recordedAt)) &&
             (!('batch_id' in data.keys()) || data.batch_id == null || data.batch_id is string) &&
             // Ensure delinquency exists
             (resource == null ? exists(/databases/$(database)/documents/delinquencies/$(data.delinquencyId)) : true);
    }

    function isValidAuditLog(data) {
      return data.userId == request.auth.uid &&
             isTime(data.timestamp) &&
             data.action is string &&
             data.entityType is string;
    }

    function isValidTaxpayerRequest(data) {
      return data.userId == request.auth.uid &&
             data.userEmail is string &&
             data.userName is string &&
             data.propertyId is string &&
             data.propertyTdn is string &&
             data.propertyOwner is string &&
             data.type in ['clearance', 'revision', 'transfer'] &&
             data.status in ['Submitted', 'Approved', 'Rejected', 'Pending'] &&
             isTime(data.createdAt);
    }

    function isValidImportBatch(data) {
      let isCreate = resource == null;
      let requiredFields = ['batch_id', 'filename', 'imported_by', 'record_count', 'import_date', 'status'];
      return (isCreate ? data.keys().hasAll(requiredFields) : true) &&
             (!('batch_id' in data.keys()) || data.batch_id is string) &&
             (!('filename' in data.keys()) || data.filename is string) &&
             (!('imported_by' in data.keys()) || data.imported_by is string) &&
             (!('record_count' in data.keys()) || data.record_count is int) &&
             (!('import_date' in data.keys()) || isTime(data.import_date)) &&
             (!('status' in data.keys()) || data.status in ['Active', 'Rolled Back']);
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn() && (userId == request.auth.uid || isAdmin() || isValidId(userId));
      allow list: if isAdmin();
      allow create: if isSignedIn() && (userId == request.auth.uid || isAdmin()) && isValidUser(incoming()) && (userId == request.auth.uid || isValidId(userId));
      allow update: if isAdmin() || (isSignedIn() && userId == request.auth.uid && isValidUser(incoming()) && (incoming().role == existing().role) && (userId == request.auth.uid || isValidId(userId)));
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isEncoder() && isValidProperty(incoming()) && isValidId(propertyId);
      allow update: if isEncoder() && isValidProperty(incoming()) && isValidId(propertyId);
      allow delete: if true; // TEMP BYPASS FOR ROLLBACK SCRIPT
    }

    match /delinquencies/{delinqId} {
      allow read: if isViewer();
      allow create: if isEncoder() && isValidDelinquency(incoming()) && isValidId(delinqId);
      allow update: if isValidId(delinqId) && (
                      isAdmin() ||
                      (isEncoder() && isValidDelinquency(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'noticeIssuedAt', 'year', 'basicTaxDue', 'sefTaxDue', 'idleSurcharge', 'penalty', 'interest', 'totalDue', 'totalPaid', 'paymentDetails', 'voidMetadata', 'pendingUpdate'])) ||
                      (isTaxpayer() && isValidDelinquency(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'totalPaid', 'updatedAt']))
                    );
      allow delete: if isAdmin() && isValidId(delinqId);
    }

    match /payments/{paymentId} {
      allow read: if isViewer();
      allow create: if isValidId(paymentId) && (isEncoder() || isTaxpayer()) && isValidPayment(incoming());
      allow update: if isValidId(paymentId) && (isAdmin() || (isEncoder() && isValidPayment(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'voidMetadata', 'updatedAt'])));
      allow delete: if isAdmin() && isValidId(paymentId);
    }

    match /import_batches/{batchId} {
      allow read: if isViewer();
      allow create: if isEncoder() && isValidImportBatch(incoming()) && isValidId(batchId);
      allow update: if isAdmin() && isValidImportBatch(incoming()) && isValidId(batchId);
      allow delete: if isAdmin() && isValidId(batchId);
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidAuditLog(incoming()) && isValidId(logId);
    }

    match /reconciliations/{yearId} {
      allow read: if isViewer();
      allow create, update: if isEncoder() && isValidId(yearId);
      allow delete: if isAdmin() && isValidId(yearId);
    }

    match /user_mappings/{mappingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(mappingId);
      allow update, delete: if isAdmin() || (isSignedIn() && resource != null && existing().email == (request.auth.token.email != null ? request.auth.token.email : '') && isValidId(mappingId));
    }

    match /taxpayer_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidTaxpayerRequest(incoming()) && isValidId(requestId);
      allow update: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid && incoming().status == existing().status));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && isValidId(requestId));
    }
  }
}
