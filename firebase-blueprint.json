{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and roles for access control.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "encoder", "viewer"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Property": {
      "title": "Property Record",
      "description": "Comprehensive information about a real property including ownership, technical description and valuation.",
      "type": "object",
      "properties": {
        "pin": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerAddress": { "type": "string" },
        "administratorName": { "type": "string" },
        "administratorAddress": { "type": "string" },
        "effectivityDate": { "type": "string" },
        "tdNumber": { "type": "string" },
        "detailedLocation": { "type": "string" },
        "street": { "type": "string" },
        "barangay": { "type": "string" },
        "municipality": { "type": "string" },
        "province": { "type": "string" },
        "lotNo": { "type": "string" },
        "blkNo": { "type": "string" },
        "octTct": { "type": "string" },
        "cctCloa": { "type": "string" },
        "classification": { "type": "string", "enum": ["LAND", "BUILDING", "MACHINERY"] },
        "area": { "type": "string" },
        "assessedValue": { "type": "number" },
        "previousTdNo": { "type": "string" },
        "previousOwner": { "type": "string" },
        "previousAssessedValue": { "type": "number" },
        "recordedBy": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "archivedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["pin", "ownerName", "barangay", "classification", "assessedValue"]
    },
    "Delinquency": {
      "title": "Delinquency Record",
      "description": "Tax delinquency information for a property in a specific year.",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string" },
        "year": { "type": "integer" },
        "basicTaxDue": { "type": "number" },
        "sefTaxDue": { "type": "number" },
        "penalty": { "type": "number" },
        "interest": { "type": "number" },
        "totalDue": { "type": "number" },
        "status": { "type": "string", "enum": ["Delinquent", "Paid", "Voided"] },
        "paymentDetails": {
          "type": "object",
          "properties": {
            "orNumber": { "type": "string" },
            "paymentDate": { "type": "string" },
            "payerName": { "type": "string" },
            "paymentType": { "type": "string", "enum": ["Full", "Partial", "Installment"] },
            "amountPaid": { "type": "number" },
            "recordedBy": { "type": "string" },
            "recordedAt": { "type": "string" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["propertyId", "year", "basicTaxDue", "status"]
    },
    "AuditLog": {
      "title": "Audit log",
      "description": "Immutable log of changes made to records.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string", "enum": ["CREATE", "UPDATE", "VOID", "LOGIN", "EXPORT"] },
        "entityId": { "type": "string" },
        "entityType": { "type": "string" },
        "oldValue": { "type": "object" },
        "newValue": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "action", "timestamp"]
    },
    "Payment": {
      "title": "Payment Record",
      "description": "Immutable record of a payment transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "delinquencyId": { "type": "string" },
        "propertyId": { "type": "string" },
        "taxYear": { "type": "integer" },
        "assessedValue": { "type": "number" },
        "orNumber": { "type": "string" },
        "paymentDate": { "type": "string", "format": "date" },
        "payerName": { "type": "string" },
        "paymentType": { "type": "string", "enum": ["Full", "Partial", "Installment"] },
        "amountPaid": { "type": "number" },
        "basicPaid": { "type": "number" },
        "sefPaid": { "type": "number" },
        "penaltyPaid": { "type": "number" },
        "recordedBy": { "type": "string" },
        "approvedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Voided"] },
        "voidMetadata": {
          "type": "object",
          "properties": {
            "reason": { "type": "string" },
            "encoder": { "type": "string" },
            "approver": { "type": "string" },
            "voidedAt": { "type": "string", "format": "date-time" }
          }
        },
        "recordedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["delinquencyId", "propertyId", "orNumber", "amountPaid", "status", "recordedAt"]
    },
    "TaxpayerRequest": {
      "title": "Taxpayer Request",
      "description": "Information regarding a dynamic application form submitted by a resident taxpayer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "propertyId": { "type": "string" },
        "propertyTdn": { "type": "string" },
        "propertyOwner": { "type": "string" },
        "type": { "type": "string", "enum": ["clearance", "revision", "transfer"] },
        "status": { "type": "string", "enum": ["Submitted", "Approved", "Rejected", "Pending"] },
        "createdAt": { "type": "string" },
        "contact": { "type": "string" },
        "purpose": { "type": "string" },
        "proposedAssessedValue": { "type": "number" },
        "reason": { "type": "string" },
        "newOwnerName": { "type": "string" },
        "newOwnerAddress": { "type": "string" },
        "transferDate": { "type": "string" }
      },
      "required": ["userId", "userEmail", "userName", "propertyId", "type", "status", "createdAt"]
    },
    "Reconciliation": {
      "title": "Reconciliation Status",
      "description": "Staff/encoder-logged details for annual tax account reconciliations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "year": { "type": "integer" },
        "propertiesChecked": { "type": "integer" },
        "totalReconciledAmount": { "type": "number" }
      },
      "required": ["id"]
    },
    "UserMapping": {
      "title": "User login identifier to email mapping",
      "description": "Helps map clean usernames to exact system auth accounts during complex registration checks.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["username", "email"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "properties": {
      "schema": "Property",
      "description": "Registry of real properties."
    },
    "delinquencies": {
      "schema": "Delinquency",
      "description": "Tax delinquency status per property/year."
    },
    "payments": {
      "schema": "Payment",
      "description": "Immutable ledger of tax payments."
    },
    "audit_logs": {
      "schema": "AuditLog",
      "description": "Audit trail for system activity."
    },
    "taxpayer_requests": {
      "schema": "TaxpayerRequest",
      "description": "Applications filed by resident taxpayers."
    },
    "reconciliations": {
      "schema": "Reconciliation",
      "description": "Annual database/treasury synchronizations."
    },
    "user_mappings": {
      "schema": "UserMapping",
      "description": "Identifier lookups."
    }
  }
}
